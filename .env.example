# Copy to .env and change every secret before the demo.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(24))"

CC_JWT_SECRET=change-me-48-hex-chars
CC_LOG_SEAL_KEY=change-me-another-48-hex-chars
CC_ADMIN_PASSWORD=Admin@12345

# Must match DEVICE_HMAC_KEY in each node's secrets.h
CC_DEVICE_KEYS=FRIDGE-A:change-me-key-for-fridge-a,FRIDGE-B:change-me-key-for-fridge-b

# Mosquitto
CC_MQTT_HOST=127.0.0.1
CC_MQTT_PORT=1883
CC_MQTT_USER=backend
CC_MQTT_PASS=change-me

# Link printed in QR codes: use the laptop's LAN address so phones can open it
CC_PUBLIC_BASE_URL=http://192.168.1.50:8000

# Alerts (fill at least one). Telegram: create a bot with @BotFather, send it a message,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
CC_TELEGRAM_BOT_TOKEN=
CC_TELEGRAM_CHAT_ID=
# E-mail (Gmail: use an App Password, port 587)
CC_SMTP_HOST=
CC_SMTP_PORT=587
CC_SMTP_USER=
CC_SMTP_PASS=
CC_ALERT_EMAIL_TO=
